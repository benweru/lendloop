# Copy to .env and fill in. Never commit real values.

# --- Next.js app (public, safe to expose) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# --- Server-side only ---
CLERK_SECRET_KEY=sk_test_replace_me
# Set by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment

# --- Convex dashboard env (npx convex env set ...) ---
# Clerk Frontend API URL
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# Shared HMAC secret; must match n8n. Generate a random 32-byte hex string.
WEBHOOK_HMAC_SECRET=replace_with_random_hex

# --- n8n (docker-compose) ---
N8N_ENCRYPTION_KEY=replace_with_random_hex
CONVEX_HTTP_URL=https://your-deployment.convex.site
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/

# Optional SMTP (workflows mock-log when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LendLoop <noreply@example.com>
