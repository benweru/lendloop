{
  "name": "LendLoop — Request notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lendloop/request-event",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-in",
      "name": "Request event webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "lendloop-request-event"
    },
    {
      "parameters": {
        "jsCode": "// Verify HMAC-SHA256 signature (mirrors convex/webhooks.ts).\n// Headers: x-lendloop-signature = sha256=<hex>, x-lendloop-timestamp = unix seconds.\n// Signed payload: `${timestamp}.${rawBody}`.\nconst crypto = require('crypto');\nconst secret = $env.WEBHOOK_HMAC_SECRET;\nconst headers = $('Request event webhook').first().json.headers ?? {};\nconst signature = headers['x-lendloop-signature'] ?? '';\nconst timestamp = String(headers['x-lendloop-timestamp'] ?? '');\nconst rawBody = JSON.stringify($json.body ?? $json);\nconst now = Math.floor(Date.now() / 1000);\nif (!secret) throw new Error('WEBHOOK_HMAC_SECRET is not set');\nif (Math.abs(now - Number(timestamp)) > 300) throw new Error('Stale timestamp');\nconst expected = 'sha256=' + crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex');\nconst a = Buffer.from(expected);\nconst b = Buffer.from(signature);\nif (a.length !== b.length || !crypto.timingSafeEqual(a, b)) throw new Error('Invalid signature');\nreturn [{ json: $json.body ?? $json }];"
      },
      "id": "verify-hmac",
      "name": "Verify HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Data minimization: keep only the fields needed to notify.\nconst e = $json;\nreturn [{ json: {\n  requestId: e.requestId,\n  toolName: e.toolName,\n  status: e.status,\n  startDate: e.startDate,\n  endDate: e.endDate,\n  recipientRole: e.status === 'pending' ? 'owner' : 'borrower',\n  borrowerId: e.borrowerId\n} }];"
      },
      "id": "minimize",
      "name": "Minimize payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "operator": {
                "operation": "larger",
                "type": "number"
              },
              "rightValue": 0,
              "id": "has-smtp",
              "leftValue": "={{ ( $env.SMTP_HOST || '' ).length }}"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "smtp-check",
      "name": "SMTP configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM }}",
        "toEmail": "=lendloop-notify@example.com",
        "subject": "=LendLoop: request {{ $json.requestId }} is {{ $json.status }}",
        "emailType": "text",
        "message": "=Tool '{{ $json.toolName }}' ({{ $json.startDate }} \u00e2\u2020\u2019 {{ $json.endDate }}) changed status to {{ $json.status }}.",
        "options": {},
        "transport": "smtp",
        "smtp": {
          "host": "={{ $env.SMTP_HOST }}",
          "port": "= {{ $env.SMTP_PORT }}",
          "secure": false
        }
      },
      "id": "send-email",
      "name": "Send email (SMTP)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1120,
        220
      ],
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "parameters": {
        "jsCode": "// Mock fallback: log the notification when SMTP is not configured.\nconsole.log('MOCK NOTIFY', JSON.stringify($json));\nreturn [{ json: { ...$json, channel: 'mock-log', notifiedAt: new Date().toISOString() } }];"
      },
      "id": "mock-log",
      "name": "Mock log notify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        400
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1340,
        300
      ]
    }
  ],
  "connections": {
    "Request event webhook": {
      "main": [
        [
          {
            "node": "Verify HMAC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify HMAC": {
      "main": [
        [
          {
            "node": "Minimize payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Minimize payload": {
      "main": [
        [
          {
            "node": "SMTP configured?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SMTP configured?": {
      "main": [
        [
          {
            "node": "Send email (SMTP)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mock log notify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send email (SMTP)": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mock log notify": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "errorWorkflow": "lendloop-error-workflow",
    "timezone": "UTC"
  },
  "staticData": null,
  "pinData": {},
  "versionId": "1",
  "triggerCount": 0,
  "active": true
}