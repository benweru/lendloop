{
  "name": "LendLoop — Overdue reminders (daily)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Daily schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Sign the Convex GET request: HMAC over `${timestamp}.` (empty body).\nconst crypto = require('crypto');\nconst secret = $env.WEBHOOK_HMAC_SECRET;\nif (!secret) throw new Error('WEBHOOK_HMAC_SECRET is not set');\nconst timestamp = String(Math.floor(Date.now() / 1000));\nconst signature = 'sha256=' + crypto.createHmac('sha256', secret).update(`${timestamp}.`).digest('hex');\nreturn [{ json: { timestamp, signature } }];"
      },
      "id": "sign-get",
      "name": "Sign request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.CONVEX_HTTP_URL }}/api/overdue",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.signature }}"
            },
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.timestamp }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "fetch-overdue",
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "parameters": {
        "fieldToSplitOut": "overdue",
        "options": {}
      },
      "id": "split",
      "name": "Split overdue items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.CONVEX_HTTP_URL }}/api/borrower-contact?borrowerId={{ $json.borrowerId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-signature",
              "value": "={{ $('Sign request').first().json.signature }}"
            },
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $('Sign request').first().json.timestamp }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "fetch-contact",
      "name": "Resolve borrower contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "parameters": {
        "jsCode": "// Send reminder (SMTP when configured, else mock-log), then build the\n// idempotent write-back body. Idempotency key = requestId + reminderDate.\nconst item = $('Split overdue items').first().json;\nconst contact = $json;\nconst smtp = $env.SMTP_HOST;\nconst channel = smtp ? 'email' : 'mock-log';\nif (!smtp) console.log('MOCK REMINDER to', contact.email, 'for request', item.requestId);\nconst crypto = require('crypto');\nconst secret = $env.WEBHOOK_HMAC_SECRET;\nconst timestamp = String(Math.floor(Date.now() / 1000));\nconst rawBody = JSON.stringify({ requestId: item.requestId, reminderDate: item.reminderDate, channel });\nconst signature = 'sha256=' + crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex');\nreturn [{ json: { rawBody, timestamp, signature, requestId: item.requestId, reminderDate: item.reminderDate, channel } }];"
      },
      "id": "send-reminder",
      "name": "Send reminder + sign ack",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONVEX_HTTP_URL }}/api/reminder-ack",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.signature }}"
            },
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.rawBody }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "ack",
      "name": "Write back reminder ack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        300
      ],
      "retryOnFail": true,
      "maxTries": 5
    }
  ],
  "connections": {
    "Daily schedule": {
      "main": [
        [
          {
            "node": "Sign request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign request": {
      "main": [
        [
          {
            "node": "Fetch overdue loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch overdue loans": {
      "main": [
        [
          {
            "node": "Split overdue items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split overdue items": {
      "main": [
        [
          {
            "node": "Resolve borrower contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resolve borrower contact": {
      "main": [
        [
          {
            "node": "Send reminder + sign ack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send reminder + sign ack": {
      "main": [
        [
          {
            "node": "Write back reminder ack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "errorWorkflow": "lendloop-error-workflow",
    "timezone": "UTC"
  },
  "staticData": null,
  "pinData": {},
  "versionId": "1",
  "triggerCount": 0,
  "active": true
}